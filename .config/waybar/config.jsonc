{
  "layer": "top",
  "position": "top",
  "height": 32,

  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "cpu",
    "memory",
    "temperature",
    "disk"
  ],

  "modules-center": ["clock"],

  "modules-right": [
    "tray",
    "pulseaudio",
    "network",
    "battery"
  ],

  "custom/launcher": {
    "format": "",
    "on-click": "rofi -show drun",
    "tooltip": "App Launcher"
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "format": "{icon}",
    "format-icons": {
      "1": "",
      "2": "",
      "3": "",
      "4": "",
      "5": "",
      "default": ""
    }
  },

  "cpu": {
    "interval": 3,
    "format": " {usage}%",
    "tooltip": false
  },

  "memory": {
    "interval": 5,
    "format": " {used:0.1f}G/{total:0.1f}G",
    "tooltip": false
  },

  "temperature": {
    "interval": 5,
    "format": " {temperatureC}°C",
    "critical-threshold": 80,
    "tooltip": false
  },

  "disk": {
    "interval": 60,
    "format": " {used:0.1f}G/{total:0.1f}G",
    "tooltip": false,
    "path": "/"
  },

  "clock": {
    "format": " {:%H:%M}   {:%d %b %Y}"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " mute",
    "format-icons": ["", "", ""]
  },

  "network": {
    "format-wifi": " {essid} ({signalStrength}%)",
    "format-ethernet": "󰈁 {ifname}",
    "format-disconnected": "󰖪"
  },

  "battery": {
    "interval": 30,
    "format": "{icon} {capacity}%",
    "format-icons": ["", "", "", "", ""]
  },

  "tray": {
    "icon-size": 18,
    "spacing": 10
  }
}
